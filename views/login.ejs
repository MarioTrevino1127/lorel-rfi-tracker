<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — The Lorel</title>
<link rel="icon" href="/favicon.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <img src="/logo.png" alt="Pillar Income Asset Management" class="brand-logo" style="margin-bottom:14px;" onerror="this.style.display='none'">
      <h1>The Lorel — RFI Log</h1>
      <p class="sub">Sign in to continue</p>
      <% if (error) { %>
        <div class="banner error"><%= error %></div>
      <% } %>
      <form method="POST" action="/login">
        <label class="field-label">Username</label>
        <input type="text" name="username" autocomplete="username" required autofocus>
        <label class="field-label">Password</label>
        <input type="password" name="password" autocomplete="current-password" required>
        <button class="action" type="submit" style="width:100%">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
