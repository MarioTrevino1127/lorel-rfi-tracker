<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Lorel — Account settings</title>
<link rel="icon" href="/favicon.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="app">
  <%- include('partials/header', { user }) %>

  <div class="card" style="max-width:420px;">
    <p class="rfi-subject" style="margin-bottom:10px;">Notification email</p>
    <% if (error) { %><div class="banner error"><%= error %></div><% } %>
    <% if (success) { %><div class="banner success"><%= success %></div><% } %>
    <form method="POST" action="/account/email">
      <label class="field-label">Email address</label>
      <input type="text" name="email" value="<%= user.email || '' %>" placeholder="you@company.com">
      <p class="note">Where notifications about RFIs needing your attention get sent. Leave blank to receive none.</p>
      <button class="action" type="submit">Save email</button>
    </form>
  </div>

  <div class="card" style="max-width:420px;">
    <p class="rfi-subject" style="margin-bottom:10px;">Change your password</p>

    <form method="POST" action="/account/change-password">
      <label class="field-label">Current password</label>
      <input type="password" name="current_password" autocomplete="current-password" required>
      <label class="field-label">New password</label>
      <input type="password" name="new_password" autocomplete="new-password" minlength="8" required>
      <label class="field-label">Confirm new password</label>
      <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required>
      <p class="note">At least 8 characters. You'll use this the next time you sign in.</p>
      <button class="action" type="submit">Update password</button>
    </form>
  </div>

  <a href="/" style="font-size:13px; color: var(--ink-soft);">&larr; Back to dashboard</a>
</div>
</body>
</html>
